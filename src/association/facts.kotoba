(ns association.facts
  "Industry rule/history catalog for UCCAEP (Unión Costarricense de
  Cámaras y Asociaciones del Sector Empresarial Privado), an
  industry-association-level source per ADR-2607141700
  (cloud-itonami-compliance-fact-federation), aligned to ISIC 9411
  (activities of business, employers, and professional membership
  organizations). Costa Rica has real, individually verified facts across
  all three axes: country (cloud-itonami-iso3166-cri statute.facts),
  municipality (cloud-itonami-municipality-cri-san-jose), and association
  (this entry).

  GENERATED by scripts/gen-kotoba-port.cljk from data/datascript-tx.edn,
  together with the Kotoba port in src/association_facts.kotoba. Do not
  hand-edit; add facts to the data file and regenerate.

  Every entry carries the page it came from (:source-article) and the
  verbatim span the claim rests on (:source-quote), and
  `nbb scripts/verify-catalog.cljk --live` fetches each :url and requires
  that span to still be in it. Reachability is not support: a URL that
  returns 200 without the claim reads exactly like one that carries it.
  uccaep.org answers a path that does not exist with its home page and
  HTTP 200, so --live also fetches a control path per origin and flags a
  source whose page is the control's answer.

  The founding year (1973) is stated by no page tried; it is reached from
  vLex's quote of a 1998 decree marking the 25th anniversary, and the
  entry records that derivation (:date-derivation) so the checker verifies
  the arithmetic rather than looking for a year the source never writes.

  No personal names of office-holders are persisted here.

  An association not in `catalog` has NO spec-basis, full stop; never
  fabricate one."
  (:require [clojure.string]))

(def catalog
  "association-slug -> vector of association-rule entries."
  {"uccaep"
   [
    {
      :association-rule/id "uccaep.founding-1973"
      :association-rule/title "UCCAEP founded in 1973 -- reached only by arithmetic: vLex's Costa Rican legal database quotes Executive Decree 27442-C as commemorating UCCAEP's creation on the ground that it celebrated its 25th anniversary in 1998. No page on uccaep.org, uccaep.or.cr or vlex.co.cr writes the year itself (measured 2026-09-11), so only the year is asserted and the derivation is recorded."
      :association-rule/association "uccaep"
      :association-rule/isic "9411"
      :association-rule/country "CRI"
      :association-rule/kind :governance-program
      :association-rule/url "https://vlex.co.cr/vid/declaracion-dia-nacional-empresa-940167862"
      :association-rule/url-provenance :legal-database-corroborated
      :association-rule/source-article "Declaración del Día Nacional de la Empresa Privada (vLex Costa Rica)"
      :association-rule/source-quote "siendo elegido este día en conmemoración de la fecha de creación de la Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado (Uccaep) -la cual en el año 1998 celebró su 25° aniversario-"
      :association-rule/established-date "1973"
      :association-rule/date-precision :year
      :association-rule/date-derivation :anniversary-arithmetic
      :association-rule/retrieved-at "2026-09-11"
      :association-rule/topic #{:governance}}
    {
      :association-rule/id "uccaep.national-private-enterprise-day-decree-1998"
      :association-rule/title "Executive Decree 27442-C of 12 November 1998 declared 23 February of each year 'Día Nacional de la Empresa Privada', the day chosen to commemorate UCCAEP's creation (vLex Costa Rica). 23 February is the commemorative date; this source does not confirm it as the literal founding day."
      :association-rule/association "uccaep"
      :association-rule/isic "9411"
      :association-rule/country "CRI"
      :association-rule/kind :governance-program
      :association-rule/url "https://vlex.co.cr/vid/declaracion-dia-nacional-empresa-940167862"
      :association-rule/url-provenance :legal-database-corroborated
      :association-rule/source-article "Declaración del Día Nacional de la Empresa Privada (vLex Costa Rica)"
      :association-rule/source-quote "mediante el Decreto Ejecutivo 27442-C, de 12 de noviembre de 1998, se declaró el 23 de febrero de cada año como"
      :association-rule/established-date "1998-11-12"
      :association-rule/date-precision :day
      :association-rule/retrieved-at "2026-09-11"
      :association-rule/topic #{:governance}}
    {
      :association-rule/id "uccaep.statutes-name-and-governing-law"
      :association-rule/title "Statutes, Article 1: the association is named Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado, may be abbreviated Unión de Cámaras or UCCAEP, and is governed by its statutes and, supplementarily, by the Ley de Asociaciones. The PDF the site links as 'estatutos actualizados mayo 2016' carries no date in its text."
      :association-rule/association "uccaep"
      :association-rule/isic "9411"
      :association-rule/country "CRI"
      :association-rule/kind :charter
      :association-rule/url "https://www.uccaep.org/images/pdfs/UCCAEP_estatutos_actualizados_mayo_2016_def.pdf"
      :association-rule/url-provenance :official-uccaep-org
      :association-rule/source-article "Estatutos de la Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado (PDF)"
      :association-rule/source-quote "ARTÍCULO PRIMERO: La Asociación se denominará Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado, pudiendo abreviarse a Unión de Cámaras o UCCAEP. Se regirá por lo dispuesto en estos Estatutos y supletoriamente por lo dispuesto en la Ley de Asociaciones y Leyes conexas."
      :association-rule/date-unknown-because :statutes-text-undated
      :association-rule/retrieved-at "2026-09-11"
      :association-rule/topic #{:governance :corporate-form}}
    {
      :association-rule/id "uccaep.statutes-general-assembly-biennial-april"
      :association-rule/title "Statutes, Article 18: the General Assembly is the highest authority and meets in ordinary session once every two years, in even years, in the second half of April"
      :association-rule/association "uccaep"
      :association-rule/isic "9411"
      :association-rule/country "CRI"
      :association-rule/kind :governance-program
      :association-rule/url "https://www.uccaep.org/images/pdfs/UCCAEP_estatutos_actualizados_mayo_2016_def.pdf"
      :association-rule/url-provenance :official-uccaep-org
      :association-rule/source-article "Estatutos de la Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado (PDF)"
      :association-rule/source-quote "ARTÍCULO DECIMO OCTAVO: La Asamblea General es la máxima autoridad de la Asociación. Será convocada ordinariamente una vez cada dos años, coincidiendo en año par, en la segunda quincena de abril"
      :association-rule/date-unknown-because :statutes-text-undated
      :association-rule/retrieved-at "2026-09-11"
      :association-rule/topic #{:governance}}
    {
      :association-rule/id "uccaep.statutes-board-25-members-six-sectors"
      :association-rule/title "Statutes, Article 30: the Consejo Directivo has twenty-five members -- the President and twenty-four Directors chosen by the six sectors that make up the association; a Director's seat belongs to the member entity, not the person, except the Presidency"
      :association-rule/association "uccaep"
      :association-rule/isic "9411"
      :association-rule/country "CRI"
      :association-rule/kind :governance-program
      :association-rule/url "https://www.uccaep.org/images/pdfs/UCCAEP_estatutos_actualizados_mayo_2016_def.pdf"
      :association-rule/url-provenance :official-uccaep-org
      :association-rule/source-article "Estatutos de la Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado (PDF)"
      :association-rule/source-quote "El Consejo Directivo está integrado por veinticinco miembros, de los cuales uno será el Presidente y veinticuatro Directores los cuales serán seleccionados por los seis sectores que conforman la Asociación. El cargo de Director no es personal sino de la entidad miembro, con excepción del Presidente."
      :association-rule/date-unknown-because :statutes-text-undated
      :association-rule/retrieved-at "2026-09-11"
      :association-rule/topic #{:governance}}
    {
      :association-rule/id "uccaep.statutes-offices-ad-honorem"
      :association-rule/title "Statutes, Article 28: seats on the Consejo Directivo, Comité Ejecutivo, Fiscalía, Foro Asesor, Consejo Consultivo and working commissions are voluntary and unpaid (ad honorem)"
      :association-rule/association "uccaep"
      :association-rule/isic "9411"
      :association-rule/country "CRI"

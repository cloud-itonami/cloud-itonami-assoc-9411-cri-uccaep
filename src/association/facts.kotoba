      :association-rule/url-provenance :official-uccaep-org
      :association-rule/source-article "Consejo directivo"
      :association-rule/source-quote "Consejo Directivo 2024-2026"
      :association-rule/established-date "2024"
      :association-rule/date-precision :year
      :association-rule/retrieved-at "2026-09-11"
      :association-rule/topic #{:governance}}]})

(defn spec-basis [association] (get catalog association))

(defn coverage
  ([] (coverage (keys catalog)))
  ([associations]
   (let [have (filter catalog associations)
         missing (remove catalog associations)]
     {:requested (count associations)
      :covered (count have)
      :covered-associations (vec (sort have))
      :missing-associations (vec (sort missing))
      :note (str "cloud-itonami-assoc-9411-cri-uccaep Wave 0 (ADR-2607141700): "
                 (count (get catalog "uccaep")) " UCCAEP entries, each citing "
                 "a source with the page and the verbatim span it rests on. "
                 "Extend data/datascript-tx.edn and regenerate; never "
                 "fabricate an id/url.")})))

(defn by-topic [association topic]
  (filterv #(contains? (:association-rule/topic %) topic) (spec-basis association)))

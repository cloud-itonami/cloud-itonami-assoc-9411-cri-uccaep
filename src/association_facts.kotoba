    (string=? f "id") (option-some-of [:option :string] "uccaep.organisational-principles")
    (string=? f "title") (option-some-of [:option :string] "UCCAEP's fourteen organisational principles (the same list as Statutes Article 4), opening with the dignity of every person, the State at the service of the common good, and the State's duty to guarantee legal certainty")
    (string=? f "association") (option-some-of [:option :string] "uccaep")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "CRI")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://www.uccaep.org/about/principios-de-la-organizacion.html")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-uccaep-org")
    (string=? f "source-article") (option-some-of [:option :string] "Principios de la organización")
    (string=? f "source-quote") (option-some-of [:option :string] "Toda persona es digna. El Estado está al servicio del bien común. El Estado tiene la obligación de garantizar la seguridad jurídica.")
    (string=? f "date-unknown-because") (option-some-of [:option :string] "page-states-standing-principles-undated")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-11")
    :else (option-none-of [:option :string])))

(defn entry-field-14 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "uccaep.objectives")
    (string=? f "title") (option-some-of [:option :string] "UCCAEP's stated objectives: unite the Costa Rican productive sector and represent it before national and international bodies, and promote laws and measures that strengthen the country's systemic competitiveness and social welfare. (The page's opening sentence repeats Statutes Article 5 and is also on the site's home page, so the span pinned here is one the home page does not carry.)")
    (string=? f "association") (option-some-of [:option :string] "uccaep")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "CRI")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://www.uccaep.org/objetivos.html")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-uccaep-org")
    (string=? f "source-article") (option-some-of [:option :string] "Objetivos")
    (string=? f "source-quote") (option-some-of [:option :string] "Unir al sector productivo costarricense y representarlo ante diferentes instancias nacionales e internacionales en temas de interés general. Impulsar la promulgación de leyes, proyectos, disposiciones, y medidas que fortalezcan la competitividad sistemática del país y el bienestar social.")
    (string=? f "date-unknown-because") (option-some-of [:option :string] "page-states-standing-objectives-undated")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-11")
    :else (option-none-of [:option :string])))


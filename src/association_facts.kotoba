;; The UCCAEP source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljs from data/datascript-tx.edn.
;; So is the Clojure reading in src/association/facts.kotoba. The facts
;; are authored once, in the data file, and nowhere else; this one also
;; reaches the Kotoba oracle, wasm and both native ISAs. Do not hand-edit
;; either -- run the generator, and `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the Clojure reading. A set has no order and `topic`
;; is indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; The parity suite that used to compare these two files does not run in
;; this repository -- see the generator's header. `--check` replaces it:
;; both readings are regenerated and compared to what is on disk.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "uccaep"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 20 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 20)) false))

(defn entry-field-0 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "uccaep.founding-1973")
    (string=? f "title") (option-some-of [:option :string] "UCCAEP founded in 1973 -- reached only by arithmetic: vLex's Costa Rican legal database quotes Executive Decree 27442-C as commemorating UCCAEP's creation on the ground that it celebrated its 25th anniversary in 1998. No page on uccaep.org, uccaep.or.cr or vlex.co.cr writes the year itself (measured 2026-09-11), so only the year is asserted and the derivation is recorded.")
    (string=? f "association") (option-some-of [:option :string] "uccaep")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "CRI")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://vlex.co.cr/vid/declaracion-dia-nacional-empresa-940167862")
    (string=? f "url-provenance") (option-some-of [:option :string] "legal-database-corroborated")
    (string=? f "source-article") (option-some-of [:option :string] "Declaración del Día Nacional de la Empresa Privada (vLex Costa Rica)")
    (string=? f "source-quote") (option-some-of [:option :string] "siendo elegido este día en conmemoración de la fecha de creación de la Unión Costarricense de Cámaras y Asociaciones del Sector Empresarial Privado (Uccaep) -la cual en el año 1998 celebró su 25° aniversario-")
    (string=? f "established-date") (option-some-of [:option :string] "1973")
    (string=? f "date-precision") (option-some-of [:option :string] "year")
    (string=? f "date-derivation") (option-some-of [:option :string] "anniversary-arithmetic")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-11")
    :else (option-none-of [:option :string])))


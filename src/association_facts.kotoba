(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "corporate-form") 2
      (string=? candidate "ethics") 1
      (string=? candidate "governance") 13
      (string=? candidate "international") 1
      (string=? candidate "legal-status") 3
      (string=? candidate "membership") 4
      (string=? candidate "policy") 1
      (string=? candidate "transparency") 1
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "corporate-form") (cond
        (= i 0) (entry-field a 2 "id")
        (= i 1) (entry-field a 10 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "ethics") (cond
        (= i 0) (entry-field a 15 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 3 "id")
        (= i 4) (entry-field a 4 "id")
        (= i 5) (entry-field a 5 "id")
        (= i 6) (entry-field a 7 "id")
        (= i 7) (entry-field a 8 "id")
        (= i 8) (entry-field a 9 "id")
        (= i 9) (entry-field a 13 "id")
        (= i 10) (entry-field a 14 "id")
        (= i 11) (entry-field a 17 "id")
        (= i 12) (entry-field a 19 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "international") (cond
        (= i 0) (entry-field a 11 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "legal-status") (cond
        (= i 0) (entry-field a 8 "id")
        (= i 1) (entry-field a 9 "id")
        (= i 2) (entry-field a 10 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "membership") (cond
        (= i 0) (entry-field a 6 "id")
        (= i 1) (entry-field a 12 "id")
        (= i 2) (entry-field a 15 "id")
        (= i 3) (entry-field a 18 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "policy") (cond
        (= i 0) (entry-field a 16 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "transparency") (cond
        (= i 0) (entry-field a 17 "id")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] 
      "cloud-itonami-assoc-9411-cri-uccaep Wave 0 (ADR-2607141700): 20 UCCAEP entries, each citing a source with the page and the verbatim span it rests on. Eighteen are first-party uccaep.org pages and documents (statutes, the public-utility decree as printed in La Gaceta, code of practice, annual report, board); two rest on vLex's legal database for the founding, which no uccaep.org page dates. Extend data/datascript-tx.edn and regenerate; never fabricate an id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
